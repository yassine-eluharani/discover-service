# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL=libsql://your-db.turso.io
DATABASE_TOKEN=your-token-here

# ── LLM (required for Tier 3 enrichment and job metadata indexing) ───────────
# At least one of the following must be set for enrichment fallback + indexer.
GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-key-here   # alternative
# LLM_URL=http://localhost:11434/v1      # local model (Ollama / llama.cpp)
# LLM_MODEL=gemini-2.0-flash            # override model name

# ── Scheduling ───────────────────────────────────────────────────────────────
INTERVAL_HOURS=2
STALE_AFTER_HOURS=2

# ── Throughput limits ────────────────────────────────────────────────────────
ENRICH_LIMIT=200    # max jobs enriched per cycle (default: 200)
INDEX_LIMIT=100     # max jobs indexed per cycle (default: 100)
CLEANUP_DAYS=7      # delete unengaged jobs older than this many days (default: 7)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
